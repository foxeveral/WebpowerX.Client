<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <AssemblyName>WebpowerX.Client</AssemblyName>
    <PackageId>WebpowerX.Client</PackageId>
    <Version>1.0.0</Version>
    <Authors>foxeveral</Authors>
    <Description>WebpowerX iEmail open API client SDK for .NET</Description>
    <PackageTags>WebpowerX</PackageTags>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/foxeveral/WebpowerX.Client</PackageProjectUrl>
    <RepositoryUrl>https://github.com/foxeveral/WebpowerX.Client</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageReleaseNotes>WebpowerX iEmail Open API client</PackageReleaseNotes>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <TargetFramework>netstandard2.1</TargetFramework>
	<RootNamespace>WebpowerX.Client</RootNamespace>
    <Nullable>enable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="10.0.11" />
    <PackageReference Include="Microsoft.Extensions.Options" Version="10.0.11" />
    <PackageReference Include="System.Text.Json" Version="10.0.11" />
  </ItemGroup>

</Project>
